class_name Campaign
extends RefCounted

## Кампания из 5 актов (черновик по MVP / славянскому лору).


static func zones() -> Array:
	return [
		# --- Акт 1: деревня + лес ---
		_z(1, "Окрайна деревни", 1, 2, false, "", "Туман ползёт от леса. Навь ещё далеко — но уже близко.", Color(0.08, 0.09, 0.1), Color(0.16, 0.18, 0.14)),
		_z(1, "Тёмный бор", 2, 2, false, "", "Стволы как рёбра. Что-то смотрит между ними.", Color(0.05, 0.07, 0.06), Color(0.1, 0.14, 0.11)),
		_z(1, "Гнилая опушка", 3, 3, true, "Лихо Одноглазое", "Земля чавкает. Здесь кончается первая тропа.", Color(0.07, 0.06, 0.08), Color(0.14, 0.12, 0.1)),

		# --- Акт 2: болота / Навь ---
		_z(2, "Трясина", 4, 2, false, "", "Нога проваливается. Из воды поднимается холод Нави.", Color(0.06, 0.08, 0.1), Color(0.12, 0.16, 0.14)),
		_z(2, "Тропа утопленниц", 5, 2, false, "", "Песни без губ. Не смотри в отражение слишком долго.", Color(0.05, 0.07, 0.12), Color(0.1, 0.13, 0.16)),
		_z(2, "Сердце болота", 6, 3, true, "Водяной", "Хозяин вод ждёт дань. Или твою голову.", Color(0.04, 0.09, 0.11), Color(0.08, 0.15, 0.14)),

		# --- Акт 3: город / раздор ---
		_z(3, "Посад у стены", 7, 2, false, "", "Дым кузниц и шёпот заговоров. Люди дерутся за хлеб и правду.", Color(0.1, 0.09, 0.08), Color(0.18, 0.15, 0.12)),
		_z(3, "Кривые улицы", 8, 2, false, "", "Князь клянётся Перуном, купцы — Велесу. Город трещит.", Color(0.11, 0.08, 0.08), Color(0.2, 0.14, 0.12)),
		_z(3, "Княжий двор", 9, 3, true, "Одержимый воевода", "Доспех звенит, а глаза — чужие. Кто им шепчет?", Color(0.12, 0.07, 0.07), Color(0.22, 0.12, 0.1)),

		# --- Акт 4: земли Велеса ---
		_z(4, "Курганная степь", 10, 2, false, "", "Ветер Стрибога гонит пыль. Под холмами — чужой скот и чужие кости.", Color(0.1, 0.09, 0.06), Color(0.2, 0.17, 0.1)),
		_z(4, "Роща идолов", 11, 2, false, "", "Лики богов стёрты, но сила осталась. Она голодна.", Color(0.08, 0.1, 0.07), Color(0.14, 0.18, 0.1)),
		_z(4, "Низина Велеса", 12, 3, true, "Аждая", "Змей поднимает головы. Здесь кончается явь.", Color(0.07, 0.06, 0.09), Color(0.12, 0.1, 0.14)),

		# --- Акт 5: подступы к большому ---
		_z(5, "Граница Нави", 13, 2, false, "", "Воздух режет кожу. Мертвые идут строем.", Color(0.05, 0.05, 0.08), Color(0.1, 0.1, 0.14)),
		_z(5, "Ледяные врата", 14, 2, false, "", "Зима без сезона. Морена касается мира пальцем.", Color(0.07, 0.08, 0.12), Color(0.12, 0.14, 0.2)),
		_z(5, "Порог зимы", 15, 3, true, "Морена", "Если она падёт — откроется дорога в эндгейм. Если нет — всё замёрзнет.", Color(0.06, 0.07, 0.14), Color(0.1, 0.12, 0.22)),
	]


static func act_title(act: int) -> String:
	match act:
		1:
			return "Акт 1 — Деревня и лес"
		2:
			return "Акт 2 — Болота Нави"
		3:
			return "Акт 3 — Город раздора"
		4:
			return "Акт 4 — Земли Велеса"
		5:
			return "Акт 5 — Порог зимы"
		_:
			return "Акт %d" % act


static func _z(act: int, name: String, ilvl: int, packs: int, boss: bool, boss_name: String, flavor: String, bg: Color, floor_c: Color) -> Dictionary:
	return {
		"act": act,
		"name": name,
		"ilvl": ilvl,
		"packs": packs,
		"boss": boss,
		"boss_name": boss_name,
		"flavor": flavor,
		"bg": bg,
		"floor": floor_c,
	}
