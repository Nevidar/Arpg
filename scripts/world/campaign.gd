static func act_title(act: int) -> String:
	match act:
		1:
			return "Акт 1 — Деревня и лес"
		2:
			return "Акт 2 — Болота Нави"
		3:
			return "Акт 3 — Город раздора"
		4:
			return "Акт 4 — Земли Велеса"
		5:
			return "Акт 5 — Порог зимы"
		_:
			return "Акт %d" % act


static func _z(act: int, name: String, ilvl: int, boss: bool, boss_name: String, flavor: String, bg: Color, floor_c: Color, map_w: float, map_h: float) -> Dictionary:
	return {
		"act": act,
		"name": name,
		"ilvl": ilvl,
		"packs": 1,
		"boss": boss,
		"boss_name": boss_name,
		"flavor": flavor,
		"bg": bg,
		"floor": floor_c,
		"map_w": map_w,
		"map_h": map_h,
	}
