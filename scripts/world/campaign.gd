		_z(4, "Курганная степь", 10, false, "", "Ветер Стрибога гонит пыль.", Color(0.24, 0.2, 0.1), Color(0.46, 0.38, 0.16), 3200, 1600),
		_z(4, "Роща идолов", 11, false, "", "Лики богов стёрты, но сила осталась.", Color(0.14, 0.22, 0.12), Color(0.28, 0.4, 0.18), 2800, 1900),
		_z(4, "Низина Велеса", 12, true, "Аждая", "Змей поднимает головы. Здесь кончается явь.", Color(0.16, 0.1, 0.22), Color(0.3, 0.18, 0.36), 2700, 1800),

		# --- Акт 5 ---
		_z(5, "Граница Нави", 13, false, "", "Воздух режет кожу. Мертвые идут строем.", Color(0.1, 0.1, 0.2), Color(0.2, 0.2, 0.34), 3000, 1800),
		_z(5, "Ледяные врата", 14, false, "", "Зима без сезона. Морена касается мира пальцем.", Color(0.12, 0.16, 0.28), Color(0.22, 0.3, 0.46), 2800, 2000),
		_z(5, "Порог зимы", 15, true, "Морена", "Если она падёт — откроется дорога в эндгейм.", Color(0.08, 0.12, 0.3), Color(0.18, 0.26, 0.5), 2600, 1700),
