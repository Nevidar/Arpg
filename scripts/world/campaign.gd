		_z(1, "Окрайна деревни", 1, false, "", "Туман ползёт от леса. Навь ещё далеко — но уже близко.", Color(0.18, 0.2, 0.16), Color(0.32, 0.38, 0.22), 2200, 1400),
		_z(1, "Тёмный бор", 2, false, "", "Стволы как рёбра. Что-то смотрит между ними.", Color(0.1, 0.16, 0.12), Color(0.18, 0.32, 0.2), 2600, 1600),
		_z(1, "Гнилая опушка", 3, true, "Лихо Одноглазое", "Земля чавкает. Здесь кончается первая тропа.", Color(0.16, 0.12, 0.1), Color(0.34, 0.26, 0.16), 2400, 1500),

		# --- Акт 2 ---
		_z(2, "Трясина", 4, false, "", "Нога проваливается. Из воды поднимается холод Нави.", Color(0.1, 0.18, 0.22), Color(0.16, 0.34, 0.32), 2800, 1800),
		_z(2, "Тропа утопленниц", 5, false, "", "Песни без губ. Не смотри в отражение слишком долго.", Color(0.08, 0.14, 0.28), Color(0.14, 0.26, 0.4), 3000, 1600),
		_z(2, "Сердце болота", 6, true, "Водяной", "Хозяин вод ждёт дань. Или твою голову.", Color(0.06, 0.2, 0.24), Color(0.1, 0.36, 0.34), 2600, 1700),

		# --- Акт 3 ---
		_z(3, "Посад у стены", 7, false, "", "Дым кузниц и шёпот заговоров.", Color(0.22, 0.16, 0.12), Color(0.4, 0.3, 0.2), 2400, 2000),
		_z(3, "Кривые улицы", 8, false, "", "Князь клянётся Перуном, купцы — Велесу.", Color(0.24, 0.12, 0.12), Color(0.42, 0.24, 0.18), 2200, 2200),
		_z(3, "Княжий двор", 9, true, "Одержимый воевода", "Доспех звенит, а глаза — чужие.", Color(0.28, 0.1, 0.1), Color(0.48, 0.22, 0.16), 2000, 1600),

